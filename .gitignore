# big / regenerable data (rebuild with scripts/fetch_insitu.py and scripts/extract_satellite.py)
data/raw/
data/interim/
data/**/*.nc
*.tif

# python / tooling
.venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/

# secrets and local artefacts (never commit credentials: Kaggle tokens, Earth Engine keys, .env)
.env
.kaggle/
access_token
kaggle.json
*service-account*.json
*.pt
*.pkl
.DS_Store
Thumbs.db

# reports are tracked (metrics, models, plots); config JSON stays tracked
!config/*.json
!reports/**/*.json
!reports/**/*.png
!reports/**/*.csv

# frontend build artefacts
frontend/node_modules/
frontend/dist/

# local junk: archives, Windows shortcuts, editor/OS files, logs
*.zip
*.lnk
*.log
desktop.ini
.vscode/
.idea/
*.swp

# python tooling caches
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# assistant / agent local state
.claude/

